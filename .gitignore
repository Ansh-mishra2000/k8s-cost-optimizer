# ==============================================================================
# Git Ignore - Kubernetes Cost Optimizer Project
# ==============================================================================

# Python Virtual Environments
venv/
.venv/
backend/venv/
backend/.venv/
env/
ENV/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/__pycache__/
backend/services/__pycache__/
backend/collector/__pycache__/
backend/database/__pycache__/

# Environment Variables & Secrets (CRITICAL: Never commit credentials to GitHub)
.env
.env.*
*.env
*.pem
*.key
*.crt
*.pfx
secrets.json

# Terraform Sensitive State & Local Cache
**/.terraform/
.terraform/
*.tfstate
*.tfstate.*
*.tfvars.json
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Kubernetes & Docker Local Configs
kubeconfig*
*.kubeconfig
docker-compose.override.yml

# IDE & Editor Configs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*